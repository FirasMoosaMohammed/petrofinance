# Django configuration
DJANGO_SECRET_KEY=petrofinance-secret-key-change-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data mode: 'demo' for local synthetic adapter, 'bigquery' for Google BigQuery
DATA_MODE=demo

# Google Cloud / BigQuery configuration (required when DATA_MODE=bigquery)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=petrofinance

